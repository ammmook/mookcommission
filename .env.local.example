# Supabase — copy this file to `.env.local` and fill in the two values.
# Both come from Supabase Dashboard > Project Settings > Data API / API Keys.
#
#   .env.local is gitignored. Never commit real keys.
#   Never add SUPABASE_SERVICE_ROLE_KEY here — this app relies on RLS + the anon
#   key only, and anything prefixed NEXT_PUBLIC_ is shipped to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
